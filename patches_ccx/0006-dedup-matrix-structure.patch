+/*  F-barES-FEM-T4: memory-bounded global dedup of the matrix structure.
+
+    mastruct.c builds the sparse structure by pushing ONE linked-list entry
+    per (dof,dof) pair of every element onto mast1/next and compressing only
+    afterwards.  The transient list is therefore as large as the SUM of the
+    per-element patterns, while the structure that survives is their UNION.
+
+    For the F-bar ES-FEM U3 volumetric elements those differ by ~24x --
+    measured on the LCOL4 cell: 1.66e9 offered against 68 318 770 distinct at
+    L_mesh 0.0120, and 9.47e9 against 4.06e8 at 0.0060 -- because the same
+    pair is produced by ~24 different edges.  The duplication is ACROSS
+    elements: within one element the jj/ll loop already emits each pair
+    exactly once, so a per-element "direct" builder cannot remove any of it.
+    Past 2^31 entries the ITG index overflows and ccx dies in u_realloc with
+    a negative allocation size, which is what put 0.0080 and 0.0060 out of
+    reach at any amount of RAM.
+
+    This deduplicates the pair stream as it arrives, so peak memory tracks the
+    final structure rather than the transient:
+
+      pairs are packed into 64-bit keys and buffered; when the buffer fills it
+      is radix-sorted, uniqued, and back-merged into one running sorted run.
+
+    The buffer starts small and doubles, up to CCX_MASTRUCT_BUF megabytes
+    (default 512), so a small model never allocates more than it needs while
+    a large one still amortises its merges.
+
+    An earlier revision also carried an open-addressing hash-set backend.  It
+    was measured slower for the same result -- 58.4 s against 26.2 s on the
+    0.0120 structure, because it pays for random probes into a table too big
+    to cache -- and its footprint scaled with the structure instead of being a
+    number you set, so it has been removed.
+
+    CCX_MASTRUCT_DEDUP=legacy falls back to the original linked list, for
+    bisecting a suspected regression.  The element loop and every SPC/MPC
+    branch in mastruct.c are identical either way: only the sink changes.   */
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#include <time.h>
+#include "CalculiX.h"
+
+/* key = column (0-based, high 32 bits) | row (1-based, low 32 bits);
+   sorting the key sorts by column then row, which is exactly the order
+   jq/irow need.  row >= 1 always, so key 0 can never occur. */
+#define MSD_KEY(row,col) ((((uint64_t)(uint32_t)(col))<<32)|(uint32_t)(row))
+
+#define MSD_BUF0 (4u*1024u*1024u)      /* 4 MB: 512k pairs to start */
+
+static int msd_on=0;                   /* backend armed for this call */
+static ITG msd_neq=0;
+
+static uint64_t *msd_buf=NULL,*msd_scr=NULL;
+static size_t msd_bufn=0,msd_bufcap=0,msd_bufmax=0;
+static uint64_t *msd_run=NULL;
+static size_t msd_runn=0,msd_runcap=0;
+
+static double msd_t0=0.0;
+static size_t msd_nadd=0,msd_spills=0;
+
+static double msd_now(void){
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC,&ts);
+  return ts.tv_sec+1.0e-9*ts.tv_nsec;
+}
+
+static long msd_hwm(void){          /* peak RSS in kB */
+  FILE *f=fopen("/proc/self/status","r");
+  char l[256]; long v=0;
+  if(!f) return 0;
+  while(fgets(l,sizeof(l),f)) if(strncmp(l,"VmHWM:",6)==0){sscanf(l+6,"%ld",&v);break;}
+  fclose(f);
+  return v;
+}
+
+int msd_active(void){ return msd_on; }
+
+/* ---------------------------------------------------------------- radix */
+
+static void msd_radix(uint64_t *a,uint64_t *tmp,size_t n){
+  static size_t cnt[65536];
+  uint64_t *src=a,*dst=tmp,*t;
+  int pass,b;
+  size_t i,s,c;
+  for(pass=0;pass<4;pass++){
+    int sh=pass*16;
+    memset(cnt,0,sizeof(cnt));
+    for(i=0;i<n;i++) cnt[(src[i]>>sh)&0xffff]++;
+    s=0;
+    for(b=0;b<65536;b++){c=cnt[b];cnt[b]=s;s+=c;}
+    for(i=0;i<n;i++) dst[cnt[(src[i]>>sh)&0xffff]++]=src[i];
+    t=src;src=dst;dst=t;
+  }
+  /* 4 passes = even number of swaps, result is back in a */
+}
+
+/* ----------------------------------------------------------- merge/spill */
+
+static void msd_oom(const char *what,size_t n){
+  printf("\n *ERROR in mastructdedup: out of memory for %s (%zu entries)\n",
+         what,n);
+  exit(1);
+}
+
+static void msd_merge(void){
+  size_t need=msd_runn+msd_bufn,i,j,w,newn;
+  uint64_t v,last=0;
+  int have=0;
+  if(need>msd_runcap){
+    uint64_t *p=(uint64_t *)realloc(msd_run,need*sizeof(uint64_t));
+    if(p==NULL) msd_oom("the running structure",need);
+    msd_run=p; msd_runcap=need;
+  }
+  /* back-merge run[0..runn) with buf[0..bufn) into run[..need), dropping
+     duplicates; writing downward from need never overtakes either read
+     cursor, so no scratch array is needed */
+  i=msd_runn; j=msd_bufn; w=need;
+  while(i>0||j>0){
+    if(i>0&&(j==0||msd_run[i-1]>=msd_buf[j-1])){
+      v=msd_run[i-1];
+      if(j>0&&msd_buf[j-1]==v) j--;
+      i--;
+    }else{
+      v=msd_buf[j-1]; j--;
+    }
+    if(have&&v==last) continue;
+    msd_run[--w]=v; last=v; have=1;
+  }
+  newn=need-w;
+  memmove(msd_run,msd_run+w,newn*sizeof(uint64_t));
+  msd_runn=newn;
+}
+
+static void msd_spill(void){
+  size_t t,k=0;
+  if(msd_bufn==0) return;
+  msd_radix(msd_buf,msd_scr,msd_bufn);
+  for(t=0;t<msd_bufn;t++) if(k==0||msd_buf[t]!=msd_buf[k-1]) msd_buf[k++]=msd_buf[t];
+  msd_bufn=k;
+  msd_merge();
+  msd_bufn=0;
+  msd_spills++;
+
+  /* a model that keeps spilling is big enough to deserve a bigger window:
+     double up to the cap, so small models stay cheap */
+  if(msd_bufcap<msd_bufmax){
+    size_t want=msd_bufcap*2;
+    uint64_t *a,*b;
+    if(want>msd_bufmax) want=msd_bufmax;
+    a=(uint64_t *)realloc(msd_buf,want*sizeof(uint64_t));
+    if(a!=NULL){
+      msd_buf=a;
+      b=(uint64_t *)realloc(msd_scr,want*sizeof(uint64_t));
+      if(b!=NULL){msd_scr=b; msd_bufcap=want;}
+    }
+  }
+}
+
+/* --------------------------------------------------------------- driver */
+
+void msd_begin(ITG *neq,ITG *nmethod,ITG *iperturb){
+  size_t mb=512;
+  const char *e;
+  msd_on=0;
+
+  if((e=getenv("CCX_MASTRUCT_DEDUP"))!=NULL&&strcmp(e,"legacy")==0){
+    printf(" SPAX: CCX_MASTRUCT_DEDUP=legacy, using the original linked list\n");
+    return;
+  }
+
+  /* the frequency/modal boundary block (neq[1]..neq[2]) still walks
+     ipointer/next directly; leave those methods on the legacy path */
+  if((*nmethod==2)||((*nmethod==4)&&(*iperturb<=1))||
+     ((*nmethod>=5)&&(*nmethod<=7))){
+    return;
+  }
+
+  if((e=getenv("CCX_MASTRUCT_BUF"))!=NULL){
+    mb=(size_t)atol(e);
+    if(mb<4) mb=4;
+  }
+  msd_bufmax=mb*1024*1024/sizeof(uint64_t);
+  msd_bufcap=MSD_BUF0/sizeof(uint64_t);
+  if(msd_bufcap>msd_bufmax) msd_bufcap=msd_bufmax;
+
+  msd_buf=(uint64_t *)malloc(msd_bufcap*sizeof(uint64_t));
+  msd_scr=(uint64_t *)malloc(msd_bufcap*sizeof(uint64_t));
+  if(msd_buf==NULL||msd_scr==NULL) msd_oom("the sort buffer",msd_bufcap);
+
+  msd_neq=neq[1];
+  msd_nadd=0; msd_spills=0; msd_runn=0; msd_bufn=0;
+  msd_t0=msd_now();
+  msd_on=1;
+}
+
+void msd_add(ITG row,ITG col){
+  msd_nadd++;
+  if(msd_bufn==msd_bufcap) msd_spill();
+  msd_buf[msd_bufn++]=MSD_KEY(row,col);
+}
+
+/* mirrors insert.c: lower triangle, diagonal excluded */
+void msd_insert(ITG *i1,ITG *i2){
+  if(*i1==*i2) return;
+  if(*i1<*i2) msd_add(*i2,*i1-1);
+  else        msd_add(*i1,*i2-1);
+}
+
+/* mirrors insertfreq.c: raw (row,column), no reordering */
+void msd_insertfreq(ITG *i1,ITG *i2){
+  msd_add(*i1,*i2-1);
+}
+
+void msd_finish(ITG **irowp,ITG *jq,ITG *nmastp){
+  ITG *irow=*irowp,col=0,r,c;
+  size_t t,p=0,n;
+
+  msd_spill();
+  n=msd_runn;
+
+  /* the sort buffer is dead the moment the last spill is merged; give it
+     back before irow is grown, so the two peaks do not overlap */
+  free(msd_buf); msd_buf=NULL;
+  free(msd_scr); msd_scr=NULL;
+  msd_bufcap=0; msd_bufn=0;
+
+  RENEW(irow,ITG,n>0?n:1);
+  jq[0]=1;
+  for(t=0;t<n;t++){
+    c=(ITG)(msd_run[t]>>32);
+    r=(ITG)(msd_run[t]&0xffffffffu);
+    while(col<c){jq[col+1]=(ITG)(p+1);col++;}
+    irow[p++]=r;
+  }
+  while(col<msd_neq){jq[col+1]=(ITG)(p+1);col++;}
+
+  printf(" SPAX: structure dedup: %.4e pairs offered, %zu distinct"
+         " (%.1fx), %zu spill(s), %.1f s, peak RSS %.2f GB\n",
+         (double)msd_nadd,n,msd_nadd?(double)msd_nadd/(double)(n?n:1):0.0,
+         msd_spills,msd_now()-msd_t0,msd_hwm()/1048576.0);
+
+  free(msd_run); msd_run=NULL; msd_runcap=0; msd_runn=0;
+  msd_on=0;
+
+  *irowp=irow;
+  *nmastp=(ITG)p;
+}
