
Opt-in out-of-core PARDISO, for factors that do not fit in RAM.

CCX_PARDISO_OOC=<MB> sets iparm[59]=2 and MKL_PARDISO_OOC_MAX_CORE_SIZE, so
MKL spills the factor to disk in sequential blocks.  The same hook stops on a
PARDISO error and reports the phase: an out-of-core run with a bad
MKL_PARDISO_OOC_PATH earlier returned a modulus forty times too stiff with
nothing in the log to say so.

VERIFIED: the bad path now exits 201 with the PARDISO error code and phase;
the switch is opt-in and the in-core path is untouched.


--- pardiso.c
+++ pardiso.c
@@ -27,6 +27,8 @@
 
 #include <mkl_service.h>
 
+void FORTRAN(pardisoinit,(long long *pt,ITG *mtype,ITG *iparm));
+
 ITG *icolpardiso=NULL,*pointers=NULL,iparm[64];
 long long pt[64];
 double *aupardiso=NULL;
@@ -297,6 +299,47 @@
     }
   }
 
+  /* F-barES-FEM-T4: CCX_PARDISO_OOC=<MB> factors OUT OF CORE.
+
+     MKL PARDISO keeps the whole factor in RAM by default, and for a wide
+     user element that is the binding constraint long before the matrix is.
+     The 0.0120 mesh at F-barES-FEM-T4 c=1: 600662 equations, 68.6M nonzeros
+     through the UNSYMMETRIC path, which stores both triangles -- asks for
+     ~44 GB of virtual and was killed at 27.2 GB anon-rss on a 30 GB machine.
+
+     iparm(60)=2 spills the factor to disk instead, in sequential blocks
+     sized by MKL_PARDISO_OOC_MAX_CORE_SIZE (MB).  Files go to
+     MKL_PARDISO_OOC_PATH, default ./ooc_temp -- the deck directory, so keep
+     the deck on real disk, not on tmpfs.
+
+     It is OPT-IN and does nothing unless the variable is set: reaching it
+     needs iparm(1)=1 ("use the values in iparm"), which means every other
+     entry has to be a deliberate value rather than an MKL default, and
+     pardisoinit is the only supported way to get those.  Stock runs keep
+     iparm(1)=0 and are bit-for-bit unaffected. */
+
+  env=getenv("CCX_PARDISO_OOC");
+  if(env!=NULL){
+    FORTRAN(pardisoinit,(pt,&mtype,iparm));
+    iparm[0]=1;
+    iparm[59]=2;
+    setenv("MKL_PARDISO_OOC_MAX_CORE_SIZE",env,1);
+    printf(" F-barES-FEM-T4: PARDISO out-of-core, max core %s MB, files in %s\n",
+	   env,getenv("MKL_PARDISO_OOC_PATH")?
+	   getenv("MKL_PARDISO_OOC_PATH"):"./ooc_temp");
+    fflush(stdout);
+
+    /* F-barES-FEM-T4: MKL PARDISO supports out-of-core only for mtype = -2 and 11, NOT
+       for mtype = 1 (structurally symmetric, numerically asymmetric).  The
+       inputformat=1 branch above (the asymmetric / F-bar path of linstatic.c)
+       has already composed the FULL general matrix into aupardiso,
+       icolpardiso, pointers -- lower triangle, diagonal AND upper triangle --
+       so it is a genuine general matrix and may be factored as mtype = 11.
+       Passing the same matrix with iparm(60)=2 under mtype = 1 makes PARDISO
+       return error -10 and the solve dies.  In-core runs keep mtype = 1. */
+    if(mtype==1) mtype=11;
+  }
+
 /* next line is for the simulateous use of PARDISO and PaStiX */
 
   mkl_domain_set_num_threads(mthread_mkl,MKL_DOMAIN_PARDISO);
@@ -305,6 +348,27 @@
 		   pointers,icolpardiso,perm,&nrhs,iparm,&msglvl,
                    b,x,&error));
 
+  /* F-barES-FEM-T4: PARDISO's return code was passed and never read.
+     ccx hands &error to all three phases and looks at it nowhere, so ANY
+     failure -- out of memory, a singular matrix, an out-of-core scratch path
+     that does not exist -- is silently ignored and the run continues on an
+     unfactored system, returning a plausible-looking wrong answer.
+     Found the hard way: an out-of-core factorisation whose
+     MKL_PARDISO_OOC_PATH pointed at a missing directory returned E_und
+     3.83e+11 against 5.52e+09 in core, and the only reason it was caught is
+     that the traction-free transverse reaction read 1.85e-02 instead of
+     5e-14.  A solver that cannot factor the matrix must stop, not guess. */
+
+  if(error!=0){
+    printf("\n *ERROR in %s: PARDISO returned error %" ITGFORMAT
+	   " (phase %" ITGFORMAT ", mtype %" ITGFORMAT ").\n",
+	   "pardiso_factor",error,phase,mtype);
+    printf("       The system was NOT solved.  Common causes: -2 out of\n");
+    printf("       memory; -4 zero pivot / singular matrix; -11 out-of-core\n");
+    printf("       scratch path missing or unwritable (MKL_PARDISO_OOC_PATH).\n");
+    exit(201);
+  }
+
   return;
 }
 
@@ -330,6 +394,10 @@
       mtype=1;
     }
   }
+  /* F-barES-FEM-T4: match pardiso_factor's out-of-core mtype upgrade, or the solve
+     phase (33) disagrees with the factor phase (12) and PARDISO returns
+     error -1.  MKL out-of-core supports only mtype -2 and 11. */
+  if(mtype==1 && getenv("CCX_PARDISO_OOC")!=NULL) mtype=11;
   iparm[1]=3;
   
   /* pardiso_factor has been called before, MKL_NUM_THREADS=mthread_mkl is set*/
@@ -342,6 +410,14 @@
 		   pointers,icolpardiso,perm,nrhs,iparm,&msglvl,
                    b,x,&error));
 
+  /* F-barES-FEM-T4: same reason as in pardiso_factor -- a failed solve must stop. */
+  if(error!=0){
+    printf("\n *ERROR in pardiso_solve: PARDISO returned error %" ITGFORMAT
+	   " (phase %" ITGFORMAT ").  The system was NOT solved.\n",
+	   error,phase);
+    exit(201);
+  }
+
   for(i=0;i<*nrhs**neq;i++){b[i]=x[i];}
   SFREE(x);
 
@@ -363,6 +439,9 @@
       mtype=1;
     }
   }
+  /* F-barES-FEM-T4: keep the cleanup phase (-1) on the same mtype the factor and solve
+     phases used under out-of-core (11, not 1). */
+  if(mtype==1 && getenv("CCX_PARDISO_OOC")!=NULL) mtype=11;
 
   FORTRAN(pardiso,(pt,&maxfct,&mnum,&mtype,&phase,neq,aupardiso,
 		   pointers,icolpardiso,perm,&nrhs,iparm,&msglvl,
