--- mafillsm.f
+++ mafillsm.f
@@ -197,6 +197,13 @@
 !     ('ES...C') a few lines up.
 !
             if((lakon(i)(1:2).eq.'U3').and.(nasym.eq.1)) cycle
+
+!     F-barES-FEM-T4: under NLGEOM the U3 element carries the FULL consistent tangent
+!     of the finite-strain force, so U2's small-strain deviatoric stiffness
+!     must not be added on top of it -- the force already carries both
+!     halves (see resultsmech_u2).
+
+            if((lakon(i)(1:2).eq.'U2').and.(iperturb(1).gt.1)) cycle
             ndof=ichar(lakon(i)(7:7))
             nope=ichar(lakon(i)(8:8))
