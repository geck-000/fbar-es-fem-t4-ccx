-     &       ielmat,mi,ncmat_,ntmat_,ipkon,lakon,ne,stiffness,nasym)
+     &       ielmat,mi,ncmat_,ntmat_,ipkon,lakon,ne,stiffness,nasym,
+     &       iperturb,vold)
 !
       elseif(lakonl(2:2).eq.'2') then
 !
--- mafillsmas.f
+++ mafillsmas.f
@@ -152,7 +152,7 @@
             if(nring.lt.1.or.nring.gt.nope) nring=nope
             call e_c3d_u3(co,kon,lakon(i),su,smu,ffu,i,elcon,nelcon,
      &           ielmat,mi,ncmat_,ntmat_,ipkon,lakon,ne,stiffness,
-     &           nasym)
+     &           nasym,iperturb,vold)
             go to 1000
           endif
           if(lakon(i)(1:2).ne.'ES') cycle
--- mafillsm.f
+++ mafillsm.f
@@ -197,6 +197,13 @@
 !     ('ES...C') a few lines up.
 !
             if((lakon(i)(1:2).eq.'U3').and.(nasym.eq.1)) cycle
+
+!     F-barES-FEM-T4: under NLGEOM the U3 element carries the FULL consistent tangent
+!     of the finite-strain force, so U2's small-strain deviatoric stiffness
+!     must not be added on top of it -- the force already carries both
+!     halves (see resultsmech_u2).
+
+            if((lakon(i)(1:2).eq.'U2').and.(iperturb(1).gt.1)) cycle
             ndof=ichar(lakon(i)(7:7))
             nope=ichar(lakon(i)(8:8))
           else
