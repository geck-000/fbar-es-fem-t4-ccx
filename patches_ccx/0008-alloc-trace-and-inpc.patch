+/* F-barES-FEM-T4: CCX_ALLOC_TRACE=<MB> logs every allocation at or above that size,
+   with the variable name and the source line that asked for it, BEFORE the
+   allocation is attempted.  A deck that dies inside the kernel OOM killer
+   never reaches u_calloc's own error path, so the only way to learn which
+   array was being grown is to print it on the way in. */
+static void msd_trace(const char *what,const char *ptr_name,const char *file,
+                      int line,size_t bytes){
+  static double thr=-1.0;
+  const char *e;
+  if(thr<0.0){
+    e=getenv("CCX_ALLOC_TRACE");
+    thr=(e!=NULL)?atof(e):0.0;
+    if(thr<=0.0) thr=1.0e30; else thr*=1048576.0;
+  }
+  if((double)bytes>=thr){
+    printf(" F-barES-FEM-T4 alloc %-8s %-14s %8.3f GB   %s:%d\n",
+           what,ptr_name,bytes/1073741824.0,file,line);
+    fflush(stdout);
+  }
+}
